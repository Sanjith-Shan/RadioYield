# Overlay for boards whose USB connector goes through a USB-UART bridge (CP210x/CH343)
# instead of the C6's native USB-Serial-JTAG. 921600 baud keeps up with the REF's RX lines;
# pass --baud 921600 to the collector.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
